# Copy file này thành .env (cùng thư mục) rồi chỉnh nếu cần.
# .env KHÔNG được commit — đã bị .gitignore chặn.
#
# BẮT BUỘC để app khởi động (thiếu là chết ngay lúc boot, có chủ đích — xem backend/docs/index.md):
#   - CLOUDINARY_NAME / CLOUDINARY_KEY / CLOUDINARY_SECRET
#   - cổng thanh toán đang chọn (PAYMENT_PROVIDER):
#       vnpay → VNPAY_TMN_CODE / VNPAY_HASH_SECRET / VNPAY_PAY_URL / VNPAY_RETURN_URL
#       payos → PAYOS_CLIENT_ID / PAYOS_API_KEY / PAYOS_CHECKSUM_KEY
# Phần còn lại đã có giá trị dùng được cho local. MAIL_* để trống vẫn khởi động — chỉ không gửi được mail.
# VNPay sandbox: tự đăng ký terminal rồi điền 2 key, hướng dẫn ở docs/vnpay-testing.md.

# --- Postgres ---
DB_URL=jdbc:postgresql://localhost:5432/self_storage
DB_USER=self_storage
DB_PASSWORD=self_storage

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- App ---
SERVER_PORT=8080
# Gốc URL frontend — dùng dựng link trong email (vd link xác nhận đề xuất khoang)
FRONTEND_URL=http://localhost:5173

# --- JWT (Base64-encoded key, at least 32 bytes; replace for non-local use) ---
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESS_TOKEN_TTL=PT15M

# --- Password hashing (bcrypt strength = log2 rounds; OWASP recommends >= 10) ---
BCRYPT_STRENGTH=10

# --- Xác minh email + chống brute-force đăng nhập ---
# Mã xác minh 6 số gửi qua email; login sai quá ngưỡng trả 429 (đếm trên Redis).
EMAIL_VERIFICATION_TTL=PT10M
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT60S
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_WINDOW=PT15M

# --- Mail: Gmail SMTP (gửi mail thật) ---
# 1) Bật xác minh 2 bước cho tài khoản Gmail.
# 2) Tạo App Password: https://myaccount.google.com/apppasswords (16 ký tự, bỏ dấu cách).
# 3) Điền MAIL_USERNAME = địa chỉ Gmail, MAIL_PASSWORD = App Password. KHÔNG commit .env.
# MAIL_FROM để trống = gửi từ MAIL_USERNAME (Gmail không cho gửi từ địa chỉ khác).
# Có thể thêm tên hiển thị: MAIL_FROM=Lemar Self Storage <ban@gmail.com>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
MAIL_TIMEOUT_MS=10000

# --- Storage: Cloudinary ---
# Ba biến dưới là @NotBlank — thiếu là app không khởi động được.
# Mỗi người tự đăng ký tài khoản free tại cloudinary.com (không cần thẻ).
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- Thanh toán ---
# Cổng đang dùng: vnpay (mặc định) | payos. Chỉ cổng đang dùng mới bắt buộc đủ biến.
PAYMENT_PROVIDER=vnpay
# payOS: lấy ở https://my.payos.vn → Kênh thanh toán → Thông tin tích hợp. KHÔNG commit key thật.
# payOS không có sandbox — thanh toán là chuyển khoản thật; không có API hoàn tiền (hoàn tay).
# Webhook: khai URL https công khai ở my.payos.vn: <public-url>/api/payments/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang FE nhận khách quay về (mặc định <FRONTEND_URL>/payments/result)
# PAYOS_RETURN_URL=http://localhost:5173/payments/result
# PAYOS_CANCEL_URL=http://localhost:5173/payments/result
# PAYOS_BASE_URL=https://api-merchant.payos.vn

# VNPay (mặc định) — bốn biến TMN_CODE / HASH_SECRET / PAY_URL / RETURN_URL bắt buộc khi PAYMENT_PROVIDER=vnpay
# (thiếu thì app không khởi động); dùng payOS thì để trống được.
# Mỗi người tự đăng ký tài khoản sandbox riêng. IPN URL khai trên portal merchant VNPay — app không đọc biến nào cho nó.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Return URL: trang kết quả FE — khách quay về, FE gọi payment-check (querydr) để chốt hoá đơn, chạy local không cần
# IPN. Chỉ test backend qua Swagger (không chạy FE) thì đặt http://localhost:8080/api/payments/vnpay/return (trả JSON
# kiểm chữ ký, không ghi dữ liệu).
VNPAY_RETURN_URL=http://localhost:5173/payments/result
# API merchant cho querydr (payment-check) — mặc định sandbox
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Chatbot tư vấn (Google Gemini) — tạo key ở https://aistudio.google.com/apikey. Để trống thì chatbot trả 503.
GEMINI_API_KEY=
# CHAT_MODEL=gemini-3.6-flash
# CHAT_THINKING_LEVEL=LOW   # để trống nếu model không hỗ trợ thinking
